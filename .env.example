APP_NAME="NexoPOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# "log" keeps everything local and switches realtime off. Set to "reverb" and run
# "php artisan reverb:start" to have stock, notifications and the order list update live.
# Safe to leave on reverb even when the socket server is down: see DEPLOY-REALTIME.md.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=127.0.0.1
SESSION_COOKIE=nexopos_session

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Hosts allowed to authenticate against /api/* with the session cookie.
# Sanctum strips the scheme off the Referer before matching, so entries must be
# host[:port] and never include "http://". Getting this wrong makes every API
# call from the dashboard answer 401 while the pages themselves still render.
# __SANCTUM_CURRENT_REQUEST_HOST__ always matches the host serving the request.
SANCTUM_STATEFUL_DOMAINS=__SANCTUM_CURRENT_REQUEST_HOST__,127.0.0.1,127.0.0.1:8000,localhost,localhost:8000
NS_ENV=production

# REVERB_SERVER_HOST/PORT is what the Reverb process BINDS to.
# Keep it on loopback when nginx or Apache proxies the socket, which is the recommended
# setup: the port is then unreachable from the internet.
REVERB_SERVER_HOST="127.0.0.1"
REVERB_SERVER_PORT=8080

# REVERB_HOST/PORT/SCHEME is what the BROWSER dials. Different thing, and mixing the two
# up is the most common reason realtime works locally and not on the tills.
#
# Leave REVERB_HOST empty to have each browser connect back to whichever host served the
# page. That is what lets the same file work on 127.0.0.1 and over the shop LAN without
# being edited per terminal, the same reasoning as the empty SESSION_DOMAIN.
REVERB_HOST=
REVERB_PORT=8080

# MUST be https when the site is served over https, otherwise the browser blocks the
# websocket as mixed content and shows nothing on the page. See DEPLOY-REALTIME.md.
REVERB_SCHEME=http

TELESCOPE_ENABLED=false

# External translation service base URL (without trailing slash), e.g. http://host.docker.internal:3000
TRANSLATOR_ENDPOINT=

# Module marketplace. Must be a full URL including the scheme, e.g. https://my.nexopos.com
# When left empty the marketplace pages stay reachable but list nothing.
MARKETPLACE_DOMAIN=
# Leave commented out to keep the built-in client id. An empty value overrides it.
# MARKETPLACE_CLIENT_ID=
