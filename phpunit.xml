      <file>./tests/Feature/Mcp/CategoriesMcpTest.php</file>
      <file>./tests/Feature/Mcp/CustomersMcpTest.php</file>
      <file>./tests/Feature/Mcp/DashboardMcpTest.php</file>
      <file>./tests/Feature/Mcp/OrdersMcpTest.php</file>
      <file>./tests/Feature/Mcp/ProductsMcpTest.php</file>
      <directory suffix="CheckMathLibraryTest.php">./tests/Feature</directory>
      <directory suffix="CrudModelRelationsTest.php">./tests/Feature</directory>
      <directory suffix="CrudPermissionsTest.php">./tests/Feature</directory>
      <directory suffix="TestLowStockProducts.php">./tests/Feature</directory>
      <directory suffix="MediaSettingsTest.php">./tests/Feature</directory>
      <directory suffix="DeleteExpiredOptionsTest.php">./tests/Feature</directory>

      <!-- The money side of a sale and of receiving goods reaching the ledger. Both files existed but
           extended Modules\NsGastro\Tests\TestCase, and that module is not installed here, so neither
           could even be loaded — which is why neither was in any suite and why accounting had no
           coverage at all beyond expenses. Every trait they use is present in tests/Traits; only the
           parent class was wrong. Placed before ResetSalesCommandTest, which clears every order. -->
      <directory suffix="AccountingProcurementTest.php">./tests/Feature</directory>
      <directory suffix="AccountingOrderTest.php">./tests/Feature</directory>

      <!-- These three write to the shared database with no isolation trait and were added in a second
           pass, after the batch above proved stable, so that a failure would have been attributable. -->
      <directory suffix="AccountingExpenseTest.php">./tests/Feature</directory>
      <directory suffix="HandlePermissionsManagement.php">./tests/Feature</directory>
      <directory suffix="ResetUserStatsTest.php">./tests/Feature</directory>

      <!-- Updating a product through the API. It had never run and needed four faults cleared before it
           could: a hardcoded unit group id, a unit picked from the wrong group, two request fields added
           after it was written, and a barcode value its own barcode type could not carry. Registering it
           also uncovered a 500 on PUT /api/products when the payload carries no groups key. -->
      <directory suffix="UpdateProductTest.php">./tests/Feature</directory>

      <!-- Second to last: it clears every order and truncates the report tables, so
           anything that reads sales data has to have run already. -->
      <directory suffix="ResetSalesCommandTest.php">./tests/Feature</directory>

      <!-- Last: it resets the administrator's password to authenticate the
           command, which would otherwise surprise a later test. -->
      <directory suffix="CreateUserCommandTest.php">./tests/Feature</directory>
    </testsuite>
